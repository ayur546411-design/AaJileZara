# AZURE_POSTGRES_URL="postgresql://jilezara_admin:YourSecretPassword123@jilezara-psql-server.postgres.database.azure.com:5432/jilezara_db?sslmode=require"

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_mock_clerk_secret_key_jilezara
CLERK_PUBLISHABLE_KEY=pk_test_mock_clerk_publishable_key
JWT_SECRET=jilezara_super_secret_jwt_key_2026

# Daily.co Live Video Calling SDK
DAILY_API_KEY=mock_daily_api_key_for_testing_video_rooms
DAILY_DOMAIN=https://jilezara.daily.co

# Azure Blob Storage (Private Recordings)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=jilezarastorage;AccountKey=MockAzureStorageKeyBase64==;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER="private-recordings"

# Azure Key Vault & App Insights
AZURE_KEY_VAULT_URI="https://jilezara-kv.vault.azure.net/"
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=mock-insights-key;IngestionEndpoint=https://centralindia-0.in.applicationinsights.azure.com/"

# Notification Services (Email & WhatsApp Business)
